{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.dev/schema/inkstone-v1.schema.json",
  "title": "Inkstone document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "canvas", "elements"],
  "properties": {
    "format": { "const": "inkstone.document" },
    "version": { "const": 1 },
    "title": { "type": "string" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/stroke" },
          { "$ref": "#/$defs/text" },
          { "$ref": "#/$defs/shape" },
          { "$ref": "#/$defs/connector" }
        ]
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "green", "blue", "alpha"],
      "properties": {
        "red": { "type": "number", "minimum": 0, "maximum": 1 },
        "green": { "type": "number", "minimum": 0, "maximum": 1 },
        "blue": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "width"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "grid_spacing", "grid_visible"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "grid_spacing": { "type": "number", "exclusiveMinimum": 0 },
        "grid_visible": { "type": "boolean" }
      }
    },
    "strokePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "pressure"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "pressure": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "kind", "style", "points"],
      "properties": {
        "type": { "const": "stroke" },
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["pen", "highlighter"] },
        "style": { "$ref": "#/$defs/style" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/strokePoint" }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "origin", "text", "font_size", "color", "max_width"],
      "properties": {
        "type": { "const": "text" },
        "id": { "$ref": "#/$defs/uuid" },
        "origin": { "$ref": "#/$defs/point" },
        "text": { "type": "string", "minLength": 1 },
        "font_size": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "$ref": "#/$defs/color" },
        "max_width": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "kind",
        "bounds",
        "rotation_degrees",
        "style",
        "fill",
        "label"
      ],
      "properties": {
        "type": { "const": "shape" },
        "id": { "$ref": "#/$defs/uuid" },
        "kind": {
          "enum": [
            "rectangle",
            "ellipse",
            "resistor",
            "capacitor",
            "ground",
            "motor",
            "gear",
            "bearing",
            "spring",
            "beam"
          ]
        },
        "bounds": { "$ref": "#/$defs/rect" },
        "rotation_degrees": { "type": "number" },
        "style": { "$ref": "#/$defs/style" },
        "fill": {
          "anyOf": [
            { "$ref": "#/$defs/color" },
            { "type": "null" }
          ]
        },
        "label": { "type": "string" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "anchor"],
      "properties": {
        "element_id": { "$ref": "#/$defs/uuid" },
        "anchor": {
          "enum": ["north", "east", "south", "west", "center", "start", "end"]
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "attachment"],
      "properties": {
        "point": { "$ref": "#/$defs/point" },
        "attachment": {
          "anyOf": [
            { "$ref": "#/$defs/attachment" },
            { "type": "null" }
          ]
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "start", "end", "route", "style", "label"],
      "properties": {
        "type": { "const": "connector" },
        "id": { "$ref": "#/$defs/uuid" },
        "start": { "$ref": "#/$defs/endpoint" },
        "end": { "$ref": "#/$defs/endpoint" },
        "route": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "style": { "$ref": "#/$defs/style" },
        "label": { "type": "string" }
      }
    }
  }
}
