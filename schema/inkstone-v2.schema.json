{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkstone.dev/schema/inkstone-v2.schema.json",
  "title": "Inkstone notebook v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "pages", "assets"],
  "properties": {
    "format": { "const": "inkstone.notebook" },
    "version": { "const": 2 },
    "title": { "type": "string" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red", "green", "blue", "alpha"],
      "properties": {
        "red": { "type": "number", "minimum": 0, "maximum": 1 },
        "green": { "type": "number", "minimum": 0, "maximum": 1 },
        "blue": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "width"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "grid_spacing", "grid_visible"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "grid_spacing": { "type": "number", "exclusiveMinimum": 0 },
        "grid_visible": { "type": "boolean" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "media_type", "data_base64"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "data_base64": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "canvas", "layers"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string" },
        "canvas": { "$ref": "#/$defs/canvas" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer" }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "visible", "locked", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "kind": { "enum": ["notes", "excel"] },
        "elements": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/stroke" },
              { "$ref": "#/$defs/text" },
              { "$ref": "#/$defs/shape" },
              { "$ref": "#/$defs/connector" },
              { "$ref": "#/$defs/media" }
            ]
          }
        },
        "spreadsheet": { "$ref": "#/$defs/spreadsheet" }
      }
    },
    "strokePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "pressure"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "pressure": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "kind", "style", "points"],
      "properties": {
        "type": { "const": "stroke" },
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["pen", "highlighter"] },
        "style": { "$ref": "#/$defs/style" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/strokePoint" }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "origin", "text", "font_size", "color", "max_width"],
      "properties": {
        "type": { "const": "text" },
        "id": { "$ref": "#/$defs/uuid" },
        "origin": { "$ref": "#/$defs/point" },
        "text": { "type": "string", "minLength": 1 },
        "font_size": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "$ref": "#/$defs/color" },
        "max_width": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "kind",
        "bounds",
        "rotation_degrees",
        "style",
        "fill",
        "label"
      ],
      "properties": {
        "type": { "const": "shape" },
        "id": { "$ref": "#/$defs/uuid" },
        "kind": {
          "enum": [
            "rectangle",
            "ellipse",
            "resistor",
            "capacitor",
            "ground",
            "motor",
            "gear",
            "bearing",
            "spring",
            "beam"
          ]
        },
        "bounds": { "$ref": "#/$defs/rect" },
        "rotation_degrees": { "type": "number" },
        "style": { "$ref": "#/$defs/style" },
        "fill": {
          "anyOf": [
            { "$ref": "#/$defs/color" },
            { "type": "null" }
          ]
        },
        "label": { "type": "string" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "anchor"],
      "properties": {
        "element_id": { "$ref": "#/$defs/uuid" },
        "anchor": {
          "enum": ["north", "east", "south", "west", "center", "start", "end"]
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "attachment"],
      "properties": {
        "point": { "$ref": "#/$defs/point" },
        "attachment": {
          "anyOf": [
            { "$ref": "#/$defs/attachment" },
            { "type": "null" }
          ]
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "start", "end", "route", "style", "label"],
      "properties": {
        "type": { "const": "connector" },
        "id": { "$ref": "#/$defs/uuid" },
        "start": { "$ref": "#/$defs/endpoint" },
        "end": { "$ref": "#/$defs/endpoint" },
        "route": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "style": { "$ref": "#/$defs/style" },
        "label": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "asset_id", "kind", "bounds", "alt_text", "caption"],
      "properties": {
        "type": { "const": "media" },
        "id": { "$ref": "#/$defs/uuid" },
        "asset_id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["image", "pdf"] },
        "bounds": { "$ref": "#/$defs/rect" },
        "alt_text": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "spreadsheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "sheets", "active_sheet"],
      "properties": {
        "origin": { "$ref": "#/$defs/point" },
        "active_sheet": { "type": "integer", "minimum": 0 },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sheet" }
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sheetCell" }
        },
        "column_widths": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "row_heights": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "merged": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frozen_rows": { "type": "integer", "minimum": 0 },
        "frozen_cols": { "type": "integer", "minimum": 0 },
        "visible_cols": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "visible_rows": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "sheetCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "string" },
        "style": { "$ref": "#/$defs/cellStyle" }
      }
    },
    "cellStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "fill": { "$ref": "#/$defs/color" },
        "h_align": { "enum": ["general", "left", "center", "right"] },
        "v_align": { "enum": ["top", "center", "bottom"] },
        "number_format": { "type": "string" },
        "font_size": { "type": "number", "minimum": 0 }
      }
    }
  }
}
